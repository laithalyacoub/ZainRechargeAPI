        },
        {
          "name": "05 Provider slow number 0799999999 (expect 202 UNKNOWN after about 5 s)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{zainUrl}}/api/recharge",
              "host": [
                "{{zainUrl}}"
              ],
              "path": [
                "api",
                "recharge"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"mobileNumber\": \"0799999999\", \"amount\": 5}"
            },
            "description": "Zain gives up after 5 seconds; the provider takes 10 seconds. Run scenario 04 or a normal recharge afterwards."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"status is UNKNOWN\", () => pm.expect(pm.response.json().status).to.eql(\"UNKNOWN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 History, page 1, size 2 (newest first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{zainUrl}}/api/recharge/history/0791234567?page=1&pageSize=2",
              "host": [
                "{{zainUrl}}"
              ],
              "path": [
                "api",
                "recharge",
                "history",
                "0791234567"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "2"
                }
              ]
            },
            "description": "Run a few recharges first. Then try page=2&pageSize=2 and compare totalCount."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paged answer\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an(\"array\");",
                  "  pm.expect(body.totalCount).to.be.at.least(body.items.length);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Rows 1 to 6 of section 15. Start Seq, the provider (5100) and Zain (5200) first."
    },
