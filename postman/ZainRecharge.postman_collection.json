{
  "info": {
    "_postman_id": "af594b69-16a2-46e4-ae39-be8302441add",
    "name": "Zain Recharge and Mock Payment Provider",
    "description": "Fake development values only. Safe to share.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Mandatory scenarios",
      "item": [
        {
          "name": "01 Recharge 5 JOD (expect 201 SUCCESS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{zainUrl}}/api/recharge",
              "host": [
                "{{zainUrl}}"
              ],
              "path": [
                "api",
                "recharge"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"mobileNumber\": \"0791234567\", \"amount\": 5}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"transaction id came from the system\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.transactionId).to.match(/^TXN-\\d+$/);",
                  "  pm.expect(body.status).to.eql(\"SUCCESS\");",
                  "  pm.expect(body.paymentReference).to.match(/^PAY-\\d+$/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Recharge 25 JOD (expect 200 FAILED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{zainUrl}}/api/recharge",
              "host": [
                "{{zainUrl}}"
              ],
              "path": [
                "api",
                "recharge"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"mobileNumber\": \"0791234567\", \"amount\": 25}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"declined: FAILED with a reason\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"FAILED\");",
                  "  pm.expect(body.failureReason).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
