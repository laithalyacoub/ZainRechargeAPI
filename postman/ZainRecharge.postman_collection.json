      "description": "Rows 16 to 23. Calls the provider directly. The folder script fetches and refreshes the bearer token.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expiresAt = Number(pm.environment.get(\"tokenExpiresAt\") || 0);",
              "",
              "if (Date.now() >= expiresAt) {",
              "  pm.sendRequest({",
              "    url: pm.environment.get(\"providerUrl\") + \"/api/auth/token\",",
              "    method: \"POST\",",
              "    header: {",
              "      \"Content-Type\": \"application/json\",",
              "      \"X-Api-Key\": pm.environment.get(\"providerApiKey\")",
              "    },",
              "    body: {",
              "      mode: \"raw\",",
              "      raw: JSON.stringify({",
              "        clientId: pm.environment.get(\"clientId\"),",
              "        clientSecret: pm.environment.get(\"clientSecret\")",
              "      })",
              "    }",
              "  }, (error, response) => {",
              "    if (error || response.code !== 200) {",
              "      console.error(\"Could not get a token\");",
              "      return;",
              "    }",
              "    const body = response.json();",
              "    pm.environment.set(\"accessToken\", body.accessToken);",
              "    // renew 30 seconds before it expires, the same rule the Zain API uses",
              "    pm.environment.set(\"tokenExpiresAt\", Date.now() + (body.expiresInSeconds - 30) * 1000);",
              "  });",
              "}"
            ]
          }
        }
      ]
