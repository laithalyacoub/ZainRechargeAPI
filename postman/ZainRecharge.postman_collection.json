            },
            "description": "Also check Seq: filter Application = 'MockPaymentProvider' and confirm no new line appeared for this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error is on amount\", () => pm.expect(pm.response.json().errors).to.have.property(\"amount\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Provider outage number 0790000000 (expect 503 + Retry-After)",
